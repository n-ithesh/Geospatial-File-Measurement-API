# ─── Geospatial File Measurement API ───────────────────────────────────────────
# Database (leave as sqlite for local dev, switch to postgres in production)
DATABASE_URL=sqlite:///./geospatial.db

# Where uploaded files are stored on disk
STORAGE_DIR=./uploads

# Upload limits (in megabytes)
MAX_UPLOAD_MB=50
MAX_UNCOMPRESSED_MB=200

# CORS – space-separated list of allowed origins
CORS_ORIGINS=["http://localhost:3000"]

# Set to true to enable DEBUG logging
DEBUG=false
